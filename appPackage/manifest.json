{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.27/MicrosoftTeams.schema.json",
    "manifestVersion": "1.27",
    "version": "1.0.2",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "My App, Inc.",
        "websiteUrl": "https://www.example.com",
        "privacyUrl": "https://www.example.com/privacy",
        "termsOfUseUrl": "https://www.example.com/termofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "CompanyIQ${{APP_NAME_SUFFIX}}",
        "full": "full name for CompanyIQ"
    },
    "description": {
        "short": "short description for CompanyIQ",
        "full": "full description for CompanyIQ"
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "bots": [
        {
            "botId": "${{BOT_ID}}",
            "scopes": [
                "team",
                "groupChat",
                "personal"
            ],
            "supportsFiles": false,
            "isNotificationOnly": false,
            "commandLists": [
                {
                    "scopes": [
                        "personal"
                    ],
                    "commands": [
                        {
                            "title": "/help",
                            "description": "List all commands and capabilities"
                        },
                        {
                            "title": "/whoami",
                            "description": "Show your identity, data scope, and available tools"
                        },
                        {
                            "title": "/data",
                            "description": "/data <question> — query company product data only"
                        },
                        {
                            "title": "/docs",
                            "description": "/docs <query> — search internal documents only"
                        },
                        {
                            "title": "/mail",
                            "description": "/mail <query> — search your email only"
                        },
                        {
                            "title": "/calendar",
                            "description": "/calendar [today|week] — your upcoming meetings"
                        },
                        {
                            "title": "/agents",
                            "description": "List external agents and their status"
                        },
                        {
                            "title": "/web",
                            "description": "/web <query> — public web search (when enabled)"
                        }
                    ]
                }
            ]
        }
    ],
    "composeExtensions": [],
    "configurableTabs": [],
    "staticTabs": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": [
        "token.botframework.com"
    ],
    "webApplicationInfo": {
        "id": "${{SSO_APP_ID}}",
        "resource": "api://botid-${{BOT_ID}}"
    }
}